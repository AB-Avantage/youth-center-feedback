# Local EZYXS SQLite is used by default. Override its location if needed.
EZYXS_DB_ENGINE=sqlite
EZYXS_SQLITE_PATH=../ezyxs-backend/db.sqlite3
FEEDBACK_DEBUG=true
FEEDBACK_ALLOWED_HOSTS=127.0.0.1,localhost

# For deployment, use a MySQL account with SELECT access only to
# facility_facility, accounts_customerprofile and accounts_customuser.
# EZYXS_DB_ENGINE=mysql
# EZYXS_DB_NAME=ezyxs
# EZYXS_DB_USER=
# EZYXS_DB_PASSWORD=
# EZYXS_DB_HOST=127.0.0.1
# EZYXS_DB_PORT=3306
# FEEDBACK_DEBUG=false
# FEEDBACK_SECRET_KEY=

# Staff password-reset email. The default backend prints messages to the
# local server console; production requires an SMTP backend and real values.
# FEEDBACK_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# FEEDBACK_EMAIL_HOST=smtp.example.com
# FEEDBACK_EMAIL_PORT=587
# FEEDBACK_EMAIL_USER=
# FEEDBACK_EMAIL_PASSWORD=
# FEEDBACK_EMAIL_USE_TLS=true
# FEEDBACK_FROM_EMAIL=no-reply@example.com
